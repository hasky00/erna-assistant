// Copy this file to Secrets.xcconfig and fill in your values.
// Secrets.xcconfig is gitignored; this example is committed.
//
// NOTE: `//` starts a comment in xcconfig, so a URL scheme must be escaped as
// `https:/$()/host` — the empty `$()` breaks up the `//` without changing the
// resulting value. Keep that form when editing.

// Where the Next.js app is deployed. For local testing against `npm run dev`
// on the simulator, use: http:/$()/localhost:3000
ERNA_API_BASE_URL = https:/$()/erna.aiassistent.site

// Same values as NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
// in .env.local. The publishable (anon) key is safe to ship in a client; it is
// the same key the web bundle already exposes, and RLS is what protects data.
ERNA_SUPABASE_URL = https:/$()/your-project.supabase.co
ERNA_SUPABASE_ANON_KEY = your-publishable-key
