# Required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Server-only. Required for Sign in with Nostr; never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Optional
TAVILY_API_KEY=

# Optional — remote Kibana Banking MCP endpoint.
# When both are set, Erna gains a `query_banking_telemetry` tool that answers
# SWIFT/SEPA/APM/log questions by delegating to the remote MCP server (via OpenAI's
# hosted MCP tool on the Responses API). Leave unset to disable the feature.
KIBANA_MCP_URL=https://mcp.bankstr.xyz/mcp
KIBANA_MCP_TOKEN=

# Documentation only (not read by app code today)
APP_URL=http://localhost:3000
# Production example: APP_URL=https://erna.aiassistent.site
