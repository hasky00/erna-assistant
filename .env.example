# Required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (cheapest) | claude-sonnet-5-5 (default) | claude-opus-5-5 (strongest)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Server-only. Required for Sign in with Nostr; never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Guest list. Comma-separated. Anyone not listed gets 403 even with a valid
# account. Leave both empty to allow every signed-in user (a warning is logged).
ERNA_ALLOWED_EMAILS=you@example.com
ERNA_ALLOWED_NPUBS=npub1...

# Per-user chat rate limits (defaults shown)
ERNA_RATE_PER_MINUTE=20
ERNA_RATE_PER_DAY=400

# Optional. Web search falls back to DuckDuckGo (free) when this is empty.
TAVILY_API_KEY=

# Documentation only (not read by app code today)
APP_URL=http://localhost:3000
