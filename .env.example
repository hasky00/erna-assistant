# Required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (cheapest) | claude-sonnet-5-5 (default) | claude-opus-5-5 (strongest)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Server-only. Required for Sign in with Nostr; never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Web search falls back to DuckDuckGo (free) when this is empty.
TAVILY_API_KEY=

# Documentation only (not read by app code today)
APP_URL=http://localhost:3000
